{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/rbd",
      "destination": "https://bound-production.up.railway.app",
      "permanent": false
    },
    {
      "source": "/rbd/:path*",
      "destination": "https://bound-production.up.railway.app/:path*",
      "permanent": false
    }
  ]
}
